.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# OS noise
.DS_Store
Thumbs.db

# Claude Code agent worktree scratch space
.claude/worktrees/

# renv: keep activate.R, settings.json, .gitignore, and the lockfile in git;
# the library itself is host-specific and is excluded by renv/.gitignore.
# (Listed here too as a safety net.)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
.vscode/

# Quarto / paper build artefacts. Rendered PDFs (.pdf) are kept in
# git as deliverables — they're regenerated cleanly on each render
# via `make pdf` (pandoc + Typst). Other formats and intermediates
# are excluded.
Australia/docs/_wp_body.md
Australia/docs/wp_draft.docx
Australia/docs/wp_draft.html
Australia/docs/wp_draft_pandoc.docx
Australia/docs/wp_draft_files/
Australia/docs/.quarto/
